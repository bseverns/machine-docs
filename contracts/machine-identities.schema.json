{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bseverns/machine-docs/contracts/machine-identities.schema.json",
  "title": "machine-docs durable physical-machine identities",
  "description": "Stable identities and local provenance only; live operation belongs to consuming systems.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "authority", "machines"],
  "properties": {
    "schema_version": {"const": 1},
    "authority": {"const": "machine-docs:durable-physical-machine-truth"},
    "machines": {
      "type": "array",
      "items": {"$ref": "#/$defs/machine"}
    }
  },
  "$defs": {
    "machine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "aliases", "documentation_path", "provenance"],
      "properties": {
        "id": {"type": "string", "pattern": "^studio-machine:[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "name": {"type": "string", "minLength": 1},
        "aliases": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "documentation_path": {"type": "string", "minLength": 1},
        "provenance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "supports"],
            "properties": {
              "source": {"type": "string", "minLength": 1},
              "supports": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"enum": ["identity", "aliases"]}
              }
            }
          }
        }
      }
    }
  }
}
